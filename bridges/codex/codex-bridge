#!/usr/bin/env bash
set -euo pipefail
if [[ "${CODEX_BRIDGE_DRY_RUN:-0}" == "1" ]]; then
  echo "codex bridge dry-run ok"
  exit 0
fi
if [[ -n "${CODEX_BRIDGE_BIN:-}" ]]; then
  exec "$CODEX_BRIDGE_BIN" "$@"
fi
echo "error: live Codex bridge is not bundled; set CODEX_BRIDGE_BIN or enable dry-run" >&2
exit 124
