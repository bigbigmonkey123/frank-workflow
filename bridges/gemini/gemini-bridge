#!/usr/bin/env bash
set -euo pipefail
if [[ "${GEMINI_BRIDGE_DRY_RUN:-0}" == "1" ]]; then
  echo "gemini bridge dry-run ok"
  exit 0
fi
if [[ -n "${GEMINI_BRIDGE_BIN:-}" ]]; then
  exec "$GEMINI_BRIDGE_BIN" "$@"
fi
echo "error: live Gemini bridge is not bundled; set GEMINI_BRIDGE_BIN or enable dry-run" >&2
exit 124
